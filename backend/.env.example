# =============================================================================
# SINALibras — backend environment variables
# Copy this file to `backend/.env` and fill in the values for local development.
# In production these come from your orchestrator (docker-compose, k8s, etc.).
# =============================================================================

# ---- Database --------------------------------------------------------------
# Connection URI. For local docker-compose use: mongodb://mongo:27017
# For a local mongod use: mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017

# Logical database name inside the Mongo deployment.
DB_NAME=sinalibras

# Optional: tune the client. Defaults are fine for development.
# MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
# MONGO_MAX_POOL_SIZE=50

# ---- HTTP / CORS -----------------------------------------------------------
# Comma-separated list of origins allowed to call the API with credentials.
# NEVER use "*" here — the API uses httpOnly cookies and the CORS spec
# forbids the combination of "*" + credentials.
CORS_ORIGINS=http://localhost:3000

# ---- Runtime ---------------------------------------------------------------
# One of: development | staging | production | test
ENVIRONMENT=development

# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# ---- JWT -------------------------------------------------------------------
# MUST be a long random string. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER commit the production value.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Cookies ---------------------------------------------------------------
# In production over HTTPS, set COOKIE_SECURE=true.
COOKIE_SECURE=false
# lax | strict | none. "lax" works when front and back share a registrable
# domain (e.g. *.example.com); use "none" + HTTPS for cross-site setups.
COOKIE_SAMESITE=lax
# Leave empty for host-only cookies (recommended for dev).
# COOKIE_DOMAIN=

# ---- Rate limits (slowapi format) -----------------------------------------
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute
